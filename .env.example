# Copy this file to .env and fill in the values.  (cp .env.example .env)
# .env is git-ignored. This example file is committed, so NO real secrets here.

# --- Gemini ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Fill these after running: python scripts/list_models.py
# (the ONE place where model names live)
GEMINI_CHAT_MODEL=
GEMINI_EMBED_MODEL=
# Optional safety limits for LLM calls (defaults shown)
LLM_REQUESTS_PER_MINUTE=10
LLM_MAX_ATTEMPTS=4

# --- PostgreSQL (used by docker-compose and by the API) ---
POSTGRES_USER=jobmatch
POSTGRES_PASSWORD=jobmatch
POSTGRES_DB=jobmatch
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://jobmatch:jobmatch@localhost:5432/jobmatch

# --- Email ---
# dry_run = print the email instead of sending it. live = really send (only after I click Send).
EMAIL_MODE=dry_run
